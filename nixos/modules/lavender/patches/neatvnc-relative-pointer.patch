+static int on_client_qemu_pointer_mode(struct nvnc_client* client)
+{
+	struct nvnc* server = client->server;
+
+	struct rfb_client_qemu_pointer_mode_msg* msg =
+	        (struct rfb_client_qemu_pointer_mode_msg*)(client->msg_buffer +
+	                                                   client->buffer_index);
+
+	if (client->buffer_len - client->buffer_index < sizeof(*msg))
+		return 0;
+
+	if (!client_has_encoding(client, RFB_ENCODING_QEMU_POINTER_MOTION_CHANGE))
+		return sizeof(*msg);
+
+	bool relative = msg->relative && server->relative_pointer_fn;
+	client->pointer_relative = relative;
+
+	/* Tell the client how PointerEvent is now interpreted: x == 0 means
+	 * relative deltas, x == 1 means absolute coordinates. */
+	struct rfb_server_fb_update_msg head = {
+		.type = RFB_SERVER_TO_CLIENT_FRAMEBUFFER_UPDATE,
+		.n_rects = htons(1),
+	};
+	struct rfb_server_fb_rect rect = {
+		.x = htons(relative ? 0 : 1),
+		.encoding = htonl(RFB_ENCODING_QEMU_POINTER_MOTION_CHANGE),
+	};
+	stream_write(client->net_stream, &head, sizeof(head));
+	stream_write(client->net_stream, &rect, sizeof(rect));
 
 	return sizeof(*msg);
 }
